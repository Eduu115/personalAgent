# ---------------------------------------------------------------- secretos
# Copia a .env y rellena. .env NO va al repo (ver .gitignore).

ANTHROPIC_API_KEY=sk-ant-...

# Genera los tres con: openssl rand -hex 24
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-
# Redis comparte red con google-mcp, que parsea correo de cualquiera.
REDIS_PASSWORD=

# ---------------------------------------------------------------- puertos
# Solo se publican en 127.0.0.1. Tailscale es quien expone el agente.
# Comprueba que estan libres:  ss -ltnp | grep -E '8420|4141'
AGENT_PORT=8420

# ---------------------------------------------------------------- modelos
# Alias definidos en config/litellm.yaml
SMART_MODEL=smart
FAST_MODEL=fast

# ---------------------------------------------------------------- helper del host
# Actualizar stacks (lab_update_stack) lo hace un proceso del HOST, fuera de
# Docker, que se instala a mano con scripts/instalar_helper.sh (ver README).
# Vacio = esa herramienta no existe para el agente.
STACKS_ACTUALIZABLES=
# Donde escucha el helper y que grupo puede hablarle (lo dice el instalador):
#   getent group puente-helper | cut -d: -f3
HELPER_SOCKET=/run/puente/helper.sock
HELPER_GID=

# ---------------------------------------------------------------- el dueno
# Para el prompt del agente: con esto, "para mi" y "hoy" significan algo sin
# tener que preguntar. El correo NO se repite aqui: se reutiliza GMAIL_USUARIO.
DUENO=Edu
ZONA_HORARIA=Europe/Madrid

# ---------------------------------------------------------------- varios
POSTGRES_USER=puente
POSTGRES_DB=puente
LOG_LEVEL=INFO
LITELLM_LOG=ERROR

# Kill switch: con true el agente responde pero no ejecuta nada con efectos.
READ_ONLY=false

# Puerto del servidor MCP del homelab (solo localhost)
MCP_PORT=8421

# GID del grupo dueno de /var/run/docker.sock. El socket-proxy corre sin root y
# entra por ese grupo. deploy.sh lo detecta y lo rellena si esta vacio.
#   Linux:           stat -Lc %g /var/run/docker.sock
#   Docker Desktop:  docker run --rm -v /var/run/docker.sock:/s alpine stat -c %g /s   (suele ser 0)
DOCKER_GID=

# ---------------------------------------------------------------- google-mcp
# Correo y calendario, solo lectura. Sin OAuth ni Google Cloud.
GOOGLE_MCP_PORT=8422

# Correo por IMAP. La contrasena es de APLICACION, no la de la cuenta: hace falta
# la verificacion en dos pasos activada, y se crea en
#   https://myaccount.google.com/apppasswords
# Google la ensena en grupos de cuatro con espacios; da igual pegarla con ellos.
GMAIL_USUARIO=
GMAIL_APP_PASSWORD=

# Calendario: la "direccion secreta en formato iCal" de cada calendario, en
# Google Calendar > Configuracion > (el calendario) > Integrar el calendario.
# Es una credencial: quien la tiene lee el calendario. Separadas por comas y
# con nombre opcional:  personal=https://...basic.ics,trabajo=https://...basic.ics
GOOGLE_ICAL_URLS=

# ---------------------------------------------------------------- briefing y ntfy
# ntfy propio (nada de ntfy.sh: el briefing lleva asuntos de correos). Solo en
# localhost; tailscale serve lo saca al tailnet (README).
NTFY_PORT=8423
# La URL con la que se llega a ntfy desde el movil (la de tailscale serve).
# EXACTAMENTE la que se pone en las apps, sin barra final: el iPhone recibe los
# avisos por ntfy.sh con el SHA256 de esta URL + el topic, y si no coincide no
# le llega nada.
NTFY_BASE_URL=https://puente.tail8b5ea7.ts.net:8444

# Dos tokens: el agente publica con uno y el movil se suscribe con el otro.
# Generalos con:  docker run --rm binwiederhier/ntfy:v2.28.0 token generate
NTFY_TOKEN_PUBLICAR=
NTFY_TOKEN_SUSCRIBIR=

# Contrasenas de los usuarios de ntfy, como hash bcrypt. edu es con la que entra
# la app del movil si no usas el token (README); la de puente no la usa nadie,
# el agente publica con su token: pon una aleatoria y olvidala. Cada hash sale de
#   docker run --rm -it binwiederhier/ntfy:v2.28.0 user hash
# y va ENTRE COMILLAS SIMPLES: sin ellas Compose toma los $ del hash por
# variables y lo corta sin avisar. deploy.sh lo comprueba.
NTFY_PASS_HASH_PUENTE=''
NTFY_PASS_HASH_EDU=''

# Cuando llega el briefing: cron de 5 campos en hora de Madrid. Vacio, apagado.
BRIEFING_CRON=30 7 * * *

# Con que busca los correos del dia. Vacia = la de por defecto (config.py), que
# es: in:inbox newer_than:1d -category:promotions -category:social
BRIEFING_QUERY=

# La URL del agente en el tailnet (la de tailscale serve, sin barra final). La
# abren los botones de aprobar y rechazar desde el movil, y es el enlace a la
# conversacion en los avisos. Antes se llamaba AGENTE_URL_PUBLICA.
PUENTE_BASE_URL=https://puente.tail8b5ea7.ts.net:8443
